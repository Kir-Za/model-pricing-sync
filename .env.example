\
# =============================================================================
# OpenRouter
# =============================================================================

# OpenRouter API base URL.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter API key used to call GET /models.
# Keep the real value only in .env.
OPENROUTER_API_KEY=

# HTTP timeout in seconds for OpenRouter requests.
OPENROUTER_TIMEOUT_SECONDS=20


# =============================================================================
# Langfuse
# =============================================================================

# Langfuse instance base URL, without /api/public.
# Examples:
#   http://localhost:3000
#   https://cloud.langfuse.com
LANGFUSE_BASE_URL=http://localhost:3000

# Langfuse project API credentials.
# Keep real values only in .env.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# HTTP timeout in seconds for Langfuse requests.
LANGFUSE_TIMEOUT_SECONDS=20

# Prefix used for custom model definitions managed by this script.
# The resulting Langfuse model name is:
#   <prefix><OpenCode model id>
# Example:
#   openrouter-sync:gpt-6-astra
LANGFUSE_MODEL_NAME_PREFIX=openrouter-sync:

# If the installed Langfuse version does not support PUT /api/public/models/{id},
# allow the script to DELETE the managed model and POST a replacement.
# 0 = fail safely
# 1 = allow delete + recreate
LANGFUSE_ALLOW_RECREATE=0


# =============================================================================
# Model mapping
# =============================================================================

# Explicit mapping from the model name emitted by OpenCode telemetry
# to the model ID used by OpenRouter.
#
# The left side MUST match the `model` value sent to Langfuse by telemetry.
# The right side MUST be an exact OpenRouter model ID from GET /api/v1/models.
#
# Keep this value on one line and as valid JSON.
#
# Example:
# MODEL_MAPPINGS_JSON={"gpt-6-astra":"openai/gpt-6-astra","gpt-6-sol":"openai/gpt-6-sol","gpt-6-luna-fast":"openai/gpt-6-luna"}
MODEL_MAPPINGS_JSON={"gpt-6-astra":"openai/gpt-6-astra","gpt-6-sol":"openai/gpt-6-sol","gpt-6-luna-fast":"openai/gpt-6-luna"}


# =============================================================================
# Pricing-field mapping
# =============================================================================

# Mapping from OpenRouter pricing object keys to Langfuse usage-detail keys.
#
# OpenRouter documents:
#   prompt      -> input token price
#   completion  -> output token price
#
# Some models/providers may expose additional pricing fields such as cache
# pricing. Unknown or absent OpenRouter fields are simply ignored.
#
# Keep this value on one line and as valid JSON.
PRICE_FIELD_MAP_JSON={"prompt":"input","completion":"output","cache_read":"cache_read_input_tokens","cache_write":"cache_write_input_tokens"}

# Require at least these OpenRouter price fields for every mapped model.
# Comma-separated. Normally prompt and completion should always be present.
REQUIRED_OPENROUTER_PRICE_FIELDS=prompt,completion


# =============================================================================
# Behaviour
# =============================================================================

# Number of Langfuse models fetched per page.
LANGFUSE_PAGE_SIZE=100

# Floating-point comparison tolerance when comparing existing Langfuse prices
# with OpenRouter prices. Prices are USD per unit/token.
PRICE_COMPARE_TOLERANCE=0.000000000001
